# Copy to .env (gitignored) and fill in. Load before cdk: set -a; source .env; set +a
# On-call engineer (decision D19). The email is the Teams mention id (UPN).
GUARDIA_ONCALL_EMAIL=
GUARDIA_ONCALL_NAME=
GUARDIA_ONCALL_BACKUP_EMAIL=
# Team email for GuardIA's own alarms (T6). SNS sends a confirmation email to accept once.
GUARDIA_ALARM_EMAIL=


# AI agent on Azure OpenAI (test account, T8). Load them into Secrets Manager with:
#   AWS_PROFILE=analytics python scripts/load_agent_secret.py
# They are never read by the code at runtime from here, only from the secret.
AZURE_OPENAI_ENDPOINT=
OPENAI_API_VERSION=
AZURE_API_MODEL=
AZURE_OPENAI_API_KEY=
